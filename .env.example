# Copy to .env for local development.

# SQLAlchemy URL, including the driver. pg_dump will not accept this form —
# see docs/restore-runbook.md for the backup URL.
DATABASE_URL=postgresql+psycopg://lockin:lockin@postgres:5432/lockin

# Signs session cookies. Any deployed environment needs its own long random
# value; rotating it signs everyone out.
SECRET_KEY=replace-with-a-long-random-value

# Google OAuth web client ID. The same value is exposed to the browser as
# VITE_GOOGLE_CLIENT_ID, which is expected — it is public.
GOOGLE_CLIENT_ID=

# Default timezone for new challenges. Every local date in the product —
# check-in days, streaks and submission deadlines — resolves in the challenge's
# own zone, and this is what new challenges are created with.
CHALLENGE_TIMEZONE=Europe/London

# false over plain HTTP locally. Must be true anywhere served over HTTPS.
SECURE_COOKIES=false

# development enables /docs; production disables it.
ENVIRONMENT=development
